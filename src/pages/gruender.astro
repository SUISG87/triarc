---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';

const mailto = "mailto:manuel@triarc.ch?subject=Triarc%20%E2%80%93%20Anfrage&body=Betrieb%3A%0AStandorte%3A%0AHeutiges%20System%3A%0A";

const stations = [
  { yr: '2023 — heute', place: 'CDS Enterprise · Interim Managing Director', what: 'Gesamtverantwortung für Strategie, Betrieb und Finanzen. Hospitality-Beratung sowie Interim- und Notfall-Mandate (Executive Chef, Head of F&B, Operations) — u. a. für Viking Expeditions und Sea Cloud II, Six Senses, Hyatt, private Luxus-Boutique-Hotels und europäische Bergresorts; internationale Überbrückungseinsätze in den Philippinen und im Nahen Osten.' },
  { yr: '2023', place: "Hotel Schweizerhof Bern, Bürgenstock Collection ★★★★★ · Executive Chef", what: "Leitung aller kulinarischen Outlets inkl. Jack's Brasserie (14 GaultMillau-Punkte), Sky Terrace und Events; 35 Mitarbeitende." },
  { yr: '2021 — 2023', place: 'Waldhaus Flims Wellness Resort ★★★★★ · Executive Chef', what: '45 Mitarbeitende über 10 Outlets. Unter seiner Führung ausgezeichnet: das Epoca mit einem Michelin-Stern und 17 GaultMillau-Punkten, das Siam mit 14 GaultMillau-Punkten. Digitalisierung der Hygiene- und Einkaufssysteme.' },
  { yr: '2019 — 2021', place: 'Kongresszentrum Davos · Executive Chef & Head of F&B', what: 'Multi-Outlet-F&B und Grossevents inkl. World Economic Forum (WEF). Catering bis 5’000 Personen, ISO 9001/14001, HACCP. Teams bis 80 Mitarbeitende.' },
  { yr: '2017 — 2019', place: 'Grand Hyatt Manila ★★★★★ · Chef de Cuisine, Pre-Opening', what: 'Eröffnungsteam eines 7-Outlet-Luxushotels; Entwicklung von Signature-Konzepten und Bankett-Operations. Das Steakhouse wurde zweifach als bestes Steakhouse der Philippinen ausgezeichnet.' },
  { yr: '2015 — 2017', place: 'Rocco Forte · Jeddah, Saudi-Arabien ★★★★★ · Chef de Cuisine, Pre-Opening', what: 'Eröffnungsteam eines Luxushauses; Aufbau der Küchen-Operations und Bankett.' },
  { yr: '2012 — 2015', place: 'The Globe · Al Faisaliah (Rosewood), Riyadh ★★★★★ · Chef de Cuisine', what: 'Leitung des preisgekrönten Fine-Dining-Restaurants The Globe — zweifach als bestes Fine-Dining-Restaurant ausgezeichnet (Saudi Tourism). VIP- und Royal-Events bis 5’000 Personen.' },
  { yr: '2010 — 2012', place: 'Trump International Golf Links · Irland ★★★★★ · Sous Chef', what: 'Erste internationale Station. Leitung von Fine-Dining-Restaurants und Bankett-Operations — ausgezeichnet als bestes Hotel-Fine-Dining (Irish Hotels Association).' },
  { yr: '2007 — 2010', place: 'Early Career · Commis bis Chef de Partie', what: 'Schweiz und Kreuzfahrt — Michelin- und Fine-Dining-Häuser, Luxushotellerie, Bankett.' },
];

const instruments = [
  { href: '/aurora', ac: 'var(--aurora)', name: 'Aurora', role: 'Kasse & Umsatzsteuerung' },
  { href: '/nova', ac: 'var(--nova)', name: 'Nova', role: 'Dienstplanung' },
  { href: '/zenith', ac: 'var(--zenith)', name: 'Zenith', role: 'HACCP & Hygiene' },
  { href: '/ceres', ac: 'var(--ceres)', name: 'Ceres', role: 'Menüplanung & Einkauf' },
];
---
<Base
  title="Der Gründer — Manuel Bänziger | Triarc"
  description="Triarc wurde von Manuel Bänziger gegründet — Executive Chef und F&B-Leader mit über 20 Jahren internationaler Erfahrung in der Spitzengastronomie. Gastronomie-Software von jemandem, der den Betrieb von innen kennt."
  lang="de"
  crumb="Der Gründer"
  ogType="profile"
>
  <main>
    <section class="hero">
      <div>
        <Mark size={72} />
        <p class="g-eyebrow"><span class="roman">—</span>Der Gründer</p>
        <h1 class="g-h1">Manuel<br />Bänziger<span class="stop">.</span></h1>
      </div>
      <div>
        <p class="section-kicker">Gastronomie-Software von jemandem, der am Pass stand.</p>
        <p class="role">Vom Küchenchef gebaut, nicht von einer Software-Firma.</p>
        <p class="narrative">Triarc wurde von Manuel Bänziger gegründet, Executive Chef und F&amp;B-Leader mit über zwanzig Jahren in der internationalen Spitzengastronomie. Er hat ausgezeichnete 5-Sterne-Häuser geführt — von der Schweiz über den Nahen Osten bis Asien — Teams bis 80 Mitarbeitende geleitet und Grossevents bis zu 5&rsquo;000 Personen verantwortet. Heute berät und führt er Hospitality-Betriebe als Interim Managing Director der CDS Enterprise. In jeder dieser Rollen kämpfte er mit denselben Werkzeugen: Excel, Papier, Software, die nie jemand am Pass getestet hatte. <strong>Also baute er die Instrumente, die er sich gewünscht hätte.</strong></p>
      </div>
    </section>

    <section class="creds reveal" aria-label="Auszeichnungen und Qualifikationen">
      <div class="cred"><div class="v">20<span class="stop">+</span></div><div class="k">Jahre Erfahrung</div></div>
      <div class="cred"><div class="v">5<span class="stop">★</span></div><div class="k">Internationale Häuser</div></div>
      <div class="cred"><div class="v">3</div><div class="k">Kontinente</div></div>
      <div class="cred"><div class="v">Lvl 4</div><div class="k">HACCP-Zertifizierung</div></div>
    </section>

    <section class="thesis reveal">
      <div>
        <p class="section-kicker">Warum Triarc</p>
        <p class="pull">Wer das Problem kennt, baut die bessere Lösung.</p>
      </div>
      <div>
        <p class="body">Die meiste Gastronomie-Software wird von Menschen gebaut, die nie eine Schicht gefahren, nie einen Wareneingang kontrolliert, nie um Mitternacht eine Kasse abgeschlossen haben. Man merkt es in jeder Funktion.</p>
        <p class="body">Triarc dreht das um. Jedes der vier Instrumente löst ein Problem, das Manuel im echten Betrieb hatte — als Küchenchef, als Head of F&amp;B, als operativ Verantwortlicher mit Budget-, KPI- und HACCP-Pflicht. <strong>Keine Funktion ohne gelebten Anlass.</strong></p>
        <p class="body">Das Ergebnis ist Software, die richtig dimensioniert ist: tief, wo es zählt — beim Nachweis, beim Deckungsbeitrag, beim Dienstplan — und schlank überall sonst.</p>
        <p class="body"><strong>Und nichts von der Stange.</strong> Sie sagen uns, wie Ihr Betrieb arbeitet — wir finden das richtige Instrument und richten es auf Sie ein. Fehlt etwas, entwickeln wir es rund um Ihren Bedarf. Eine Lösung pro Problem und pro Haus, nicht eine für alle.</p>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Stationen</p>
      <div class="cv">
        {stations.map((s) => (
          <div class="station">
            <span class="yr">{s.yr}</span>
            <div>
              <p class="place" set:html={s.place.replace('★★★★★', '<span class="star">★★★★★</span>')}></p>
              <p class="what" set:html={s.what}></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Grossanlässe &amp; Gäste</p>
      <p class="pull" style="margin-bottom:26px;">Vom Pass bis zum Staatsbankett.</p>
      <p class="g-prose">Über zwei Jahrzehnte hat Manuel Grossanlässe bis zu <strong>5&rsquo;000 Gäste</strong> geplant und orchestriert — von königlichen Hochzeiten am saudischen Königshof bis zu Staatsempfängen und Delegationen am World Economic Forum in Davos.</p>
      <p class="g-prose" style="margin:0;">Zu den bewirteten Gästen zählten Staatsoberhäupter und internationale Persönlichkeiten — unter anderem <strong>Bill Clinton</strong>, <strong>Barack Obama</strong>, <strong>Donald Trump</strong>, <strong>Angela Merkel</strong> und <strong>The Rolling Stones</strong> — und viele weitere weltweit bekannte Persönlichkeiten, die wir aus Gründen der Vertraulichkeit (NDA) und zum Schutz ihrer Privatsphäre nicht nennen.</p>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Auszeichnungen</p>
      <p class="pull" style="margin-bottom:30px;">Unter seiner Führung ausgezeichnet.</p>
      <div class="edu-grid">
        <div class="edu">
          <h3>Schweiz</h3>
          <ul class="list">
            <li><strong>Epoca</strong>, Waldhaus Flims — 1 Michelin-Stern und 17 GaultMillau-Punkte</li>
            <li><strong>Siam</strong>, Waldhaus Flims — 14 GaultMillau-Punkte</li>
            <li><strong>Jack&rsquo;s Brasserie</strong>, Hotel Schweizerhof Bern — 14 GaultMillau-Punkte</li>
          </ul>
        </div>
        <div class="edu">
          <h3>International</h3>
          <ul class="list">
            <li><strong>The Globe</strong>, Riyadh — zweifach als bestes Fine-Dining-Restaurant ausgezeichnet (Saudi Tourism · 2012 &amp; 2013)</li>
            <li><strong>Trump International</strong>, Irland — bestes Hotel-Fine-Dining (Irish Hotels Association · 2011)</li>
            <li><strong>Grand Hyatt Manila</strong> — zweifach als bestes Steakhouse der Philippinen ausgezeichnet</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Ausbildung &amp; Weiterbildung</p>
      <div class="edu-grid">
        <div class="edu">
          <h3>Ausbildung</h3>
          <ul class="list">
            <li>Eidg. dipl. Hotelmanager HF (NDS), Hotelfachschule Thun — in Ausbildung (2027)</li>
            <li>Eidg. dipl. Küchenchef &amp; Produktionsleiter (2026)</li>
            <li>Chefkoch mit eidg. Fachausweis (EFA) (2025)</li>
            <li>Koch EFZ, Restaurant David 38, St. Gallen (2004–2007) — 15 GaultMillau-Punkte</li>
          </ul>
        </div>
        <div class="edu">
          <h3>Weiterbildung</h3>
          <ul class="list">
            <li>Cornell University — Executive Education, Food &amp; Beverage Management (2025)</li>
            <li>Cornell University — Hotel Management 360, Executive Education</li>
            <li>Harvard ManageMentor — Harvard Business School (2015)</li>
            <li>HACCP Level 4 (2023), Level 3 (2018), Level 1 (2015)</li>
            <li>HACCP-Auditor</li>
            <li>ISO-14001-Auditor (Umweltmanagement)</li>
            <li>SHIPSAN-zertifiziert (Schiffshygiene / Public Health)</li>
            <li>USPH-geschult (Vessel Sanitation Program)</li>
            <li>Krisenmanagement &amp; menschliches Verhalten (2024)</li>
            <li>STCW 95 — Sicherheitstraining Hochseeschiff (2024)</li>
            <li>Sicherheitsbewusstsein für Seefahrer (2024)</li>
            <li>Berufsbildner (2009)</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Die vier Instrumente</p>
      <div class="instruments-row">
        {instruments.map((i) => (
          <a class="inst" href={i.href} style={`--ac:${i.ac}`}>
            <div class="ar" aria-hidden="true"></div>
            <h3>{i.name}<span class="stop">.</span></h3>
            <p>{i.role}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="cta-band reveal">
      <h2>Sprechen Sie mit dem, der es gebaut hat.</h2>
      <p>Kein Vertriebsteam, kein Call-Center — direkt mit dem Gründer. Erzählen Sie, wie Ihr Betrieb arbeitet, und wir finden heraus, welches Instrument passt.</p>
      <p class="contact-line dim">Schweizer Datenschutz · Daten in CH/EU, revDSG-konform · kein Knebelvertrag · Einrichtung persönlich begleitet</p>
      <a class="btn" href={mailto}>Kontakt aufnehmen →</a>
      <p class="contact-line">Direkt: <a href="mailto:manuel@triarc.ch">manuel@triarc.ch</a></p>
    </section>
  </main>
</Base>

<style>
  main { width: min(1080px, calc(100% - 64px)); margin: 0 auto; padding: 18px 0 24px; }

  .hero { display: grid; grid-template-columns: minmax(260px, 0.7fr) minmax(320px, 1fr); gap: clamp(40px, 7vw, 90px); align-items: end; padding: 30px 0 50px; border-bottom: 1px solid var(--rule); }
  .hero :global(.mark) { margin-bottom: 28px; }
  .g-eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 14px; }
  .g-eyebrow .roman { color: var(--gold); margin-right: 10px; }
  .g-h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(52px, 8vw, 104px); line-height: 0.9; letter-spacing: -0.01em; margin: 0; }
  .g-h1 .stop { color: var(--gold); }
  .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(22px, 2.8vw, 32px); line-height: 1.22; margin: 0 0 22px; color: var(--ink); }
  .narrative { font-size: 16.5px; line-height: 1.78; color: var(--ink); margin: 0; max-width: 42rem; }
  .narrative strong { font-weight: 500; }

  .creds { display: flex; flex-wrap: wrap; gap: 0; padding: 40px 0; border-bottom: 1px solid var(--rule); }
  .cred { flex: 1 1 auto; min-width: 140px; padding: 4px 28px 4px 0; margin-right: 28px; border-right: 1px solid var(--rule); }
  .cred:last-child { border-right: 0; }
  .cred .v { font-family: var(--serif); font-size: clamp(26px, 3vw, 38px); line-height: 1; color: var(--ink); }
  .cred .v .stop { color: var(--gold); }
  .cred .k { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); margin-top: 9px; }

  .thesis { padding: 56px 0; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(38px, 6vw, 76px); }
  .thesis .body { margin: 0 0 16px; font-size: 16px; line-height: 1.72; color: var(--ink); }
  .thesis .body:last-child { margin-bottom: 0; }
  .thesis .body strong { font-weight: 500; }

  .block { padding: 56px 0; border-bottom: 1px solid var(--rule); }
  .block > .section-kicker { margin-bottom: 30px; }
  .g-prose { font-size: 16px; line-height: 1.72; color: var(--ink); max-width: 44rem; margin: 0 0 16px; }
  .g-prose strong { font-weight: 500; }

  .cv { display: grid; gap: 0; }
  .station { display: grid; grid-template-columns: 130px 1fr; gap: 28px; padding: 20px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .station:first-child { border-top: 0; padding-top: 0; }
  .station .yr { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: var(--gold); }
  .station .place { font-family: var(--sans); font-weight: 500; font-size: 16px; margin: 0 0 4px; }
  .station .place :global(.star) { color: var(--gold); font-size: 12px; }
  .station .what { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }

  .edu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 56px; }
  .edu h3 { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 16px; font-weight: 400; }
  .list { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
  .list li { position: relative; padding-left: 20px; font-size: 14.5px; line-height: 1.55; color: var(--ink); }
  .list li::before { content: ""; position: absolute; left: 0; top: 0.68em; width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }
  .list strong { font-weight: 500; }

  .instruments-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .inst { padding: 22px 20px 24px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); transition: background 180ms ease; }
  .inst:hover { background: var(--paper-deep); }
  .inst .ar { width: 26px; height: 2px; background: var(--ac); margin-bottom: 12px; }
  .inst h3 { font-family: var(--serif); font-weight: 400; font-size: 22px; margin: 0 0 4px; }
  .inst h3 .stop { color: var(--ac); }
  .inst p { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--ink-soft); }

  .cta-band { margin: 64px 0 8px; padding: clamp(46px, 7vw, 80px) clamp(28px, 5vw, 64px); background: var(--paper-deep); border-top: 1px solid var(--gold); border-bottom: 1px solid var(--gold); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .cta-band h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(28px, 4vw, 50px); line-height: 1.05; margin: 0; max-width: 16em; }
  .cta-band p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--ink-soft); max-width: 40rem; }
  .contact-line { font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-soft); }
  .contact-line.dim { opacity: 0.85; }
  .contact-line a { color: var(--ink); border-bottom: 1px solid var(--gold); padding-bottom: 2px; }
  .contact-line a:hover { color: var(--gold); }

  @media (max-width: 900px) { .instruments-row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 820px) {
    main { width: min(100% - 44px, 660px); }
    .hero { grid-template-columns: 1fr; gap: 26px; padding-top: 24px; }
    .thesis { grid-template-columns: 1fr; gap: 26px; }
    .station { grid-template-columns: 1fr; gap: 5px; }
    .edu-grid { grid-template-columns: 1fr; gap: 28px; }
    .creds { gap: 18px 0; }
    .cred { flex: 1 1 45%; border-right: 0; padding-right: 0; margin-right: 0; }
  }
  @media (max-width: 480px) { .instruments-row { grid-template-columns: 1fr; } .btn { width: 100%; justify-content: center; } }
</style>
