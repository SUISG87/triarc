---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Triarc',
  url: 'https://triarc.ch/',
  email: 'manuel@triarc.ch',
  founder: { '@type': 'Person', name: 'Manuel Bänziger' },
  description: 'Drei Leistungen für Gastronomie und Hotellerie: Software, Beratung und Recruiting.',
  address: { '@type': 'PostalAddress', addressLocality: 'St. Gallen', addressCountry: 'CH' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungen',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Software für die Gastronomie',
          description: 'Vier Instrumente für Umsatz, Personal, Hygiene und Küchenplanung — dazu individuell gebaute Software aus dem Atelier.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Beratung für Gastronomie und Hotellerie',
          description: 'Front und Back Office, Betrieb und Kalkulation, Neueröffnung und Konzept, Führung und Team.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Recruiting für Gastronomie und Hotellerie',
          description: 'Kaderstellen und alle Positionen in Küche und Service, inklusive kurzfristiger Vertretungen.',
        },
      },
    ],
  },
};
---
<Base
  title="Triarc — Software, Beratung und Recruiting für die Gastronomie"
  description="Drei Leistungen für Gastronomie und Hotellerie: Software — vier Instrumente plus individuelle Entwicklung im Atelier —, Beratung und Recruiting. Entwickelt von einem Küchenchef, nicht von einer Software-Firma."
  lang="de"
  crumb="CH"
  altHref="/en/"
  hreflang={{ de: '/', en: '/en/' }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <Home lang="de" />
</Base>
