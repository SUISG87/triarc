---
const { lang = 'en' } = Astro.props;
const pre = lang === 'en' ? '/en' : '';
const en = lang === 'en';
const t = en
  ? { founders: 'Founded by Manuel & Lalaine Bänziger', impressum: 'Imprint', privacy: 'Privacy', loc: 'St. Gallen · Switzerland' }
  : { founders: 'Gegründet von Manuel & Lalaine Bänziger', impressum: 'Impressum', privacy: 'Datenschutz', loc: 'St. Gallen · Schweiz' };
---
<footer class="site-foot">
  <span>© Triarc 2026 · {t.loc}</span>
  <span class="links">
    <span class="founders">{t.founders}</span>
    <a class="legal" href={`${pre}/impressum`}>{t.impressum}</a>
    <a class="legal" href={`${pre}/datenschutz`}>{t.privacy}</a>
  </span>
</footer>
