---
import Mark from './Mark.astro';
// Ridge.astro holds the engraved line-art horizon — the alternative to the photograph.
import Backdrop from './Backdrop.astro';
const { lang = 'de' } = Astro.props;

const MAIL = 'manuel@triarc.ch';

const C = {
  de: {
    tagline: ['Individuelle Instrumente für die Gastronomie.', 'Schweizer Ingenieurskunst.'],
    status: 'Im Aufbau · Anfragen offen',
    backdropAlt: 'Das Alpsteinmassiv mit dem Säntis im Morgenlicht.',
    inspect: 'Leistungen ansehen',
    servicesLabel: 'Drei Leistungen',
    servicesLede: 'Ein Haus zu führen ist mehr als eine Software. Wir arbeiten an drei Stellen —',
    servicesLedeAccent: 'und Sie wählen, wo es klemmt.',
    instrumentsLabel: 'Vier Instrumente',
    lede: 'Keine Lösung für alle. Sagen Sie uns, wie Ihr Haus arbeitet — wir finden das richtige Instrument und richten es auf Sie ein.',
    more: 'Mehr erfahren',
  },
  en: {
    tagline: ['Individual instruments for hospitality.', 'Swiss-engineered.'],
    status: 'In build · Open for enquiries',
    backdropAlt: 'The Alpstein massif with the Säntis at first light.',
    inspect: 'See what we do',
    servicesLabel: 'Three services',
    servicesLede: 'Running a house takes more than software. We work at three points —',
    servicesLedeAccent: 'you choose where it hurts.',
    instrumentsLabel: 'Four instruments',
    lede: 'Not one application for everyone. Tell us how your house runs — we find the right instrument and shape it around your work.',
    more: 'Read the instrument',
  },
};

// The three services. Software opens into the instrument case below; the other
// two lead to a plain enquiry — no thin pages promising more than exists.
const services = [
  {
    roman: 'I', key: 'software', href: '#instruments',
    de: {
      eyebrow: 'Gastronomie-Software', name: 'Software',
      role: 'Vier Instrumente. Oder eines, das es noch nicht gibt.',
      body: 'Kasse, Dienstplan, HACCP, Küchenplanung — vier Instrumente, für die Gastronomie gebaut. Passt keines davon zu Ihrem Haus, baut das Atelier, was Sie brauchen.',
      action: 'Instrumente ansehen',
    },
    en: {
      eyebrow: 'Hospitality software', name: 'Software',
      role: 'Four instruments. Or one that does not exist yet.',
      body: 'Point of sale, scheduling, HACCP, kitchen planning — four instruments, built for hospitality. If none of them fits your house, the Atelier builds what you need.',
      action: 'Inspect the instruments',
    },
  },
  {
    roman: 'II', key: 'beratung', subject: { de: 'Anfrage Beratung', en: 'Consulting enquiry' },
    de: {
      eyebrow: 'Gastronomie & Hotellerie', name: 'Beratung',
      role: 'Von der Reception bis zur Patisserie.',
      body: 'Nicht nur Küche, sondern das ganze Haus: Front und Back Office, Betrieb und Kalkulation, Neueröffnung und Konzept, Führung und Team. Von der Opera-Schulung an der Reception bis zur Organisation von Küche und Patisserie — und zur Frage, welche Systeme ein Haus wirklich braucht.',
      action: 'Anfrage senden',
    },
    en: {
      eyebrow: 'Hospitality consulting', name: 'Consulting',
      role: 'From the front desk to the patisserie.',
      body: 'Not only the kitchen — the whole house: front and back office, operations and costing, openings and concept, leadership and team. From Opera training at reception to organising a kitchen or a patisserie — and to the question of which systems a house actually needs.',
      action: 'Send an enquiry',
    },
  },
  {
    roman: 'III', key: 'recruiting', subject: { de: 'Anfrage Recruiting', en: 'Recruiting enquiry' },
    de: {
      eyebrow: 'Personal & Vermittlung', name: 'Recruiting',
      role: 'Besetzt. Auch übermorgen.',
      body: 'Kaderstellen und jede Position in Küche und Service — vermittelt und eingearbeitet, direkt im Dienstplan. Und wenn Krankheit, Unfall oder ein kurzfristiger Ausfall ein Loch reisst: erfahrene Fachkräfte, international abrufbar, die einspringen — so lange, wie es nötig ist.',
      action: 'Anfrage senden',
    },
    en: {
      eyebrow: 'People & placement', name: 'Recruiting',
      role: 'Covered. The day after tomorrow, too.',
      body: 'Head-of roles and every position in kitchen and service — placed and settled in, straight into the schedule. And when illness, an accident or a sudden absence tears a hole: experienced professionals, available internationally at short notice, stepping in for as long as it takes.',
      action: 'Send an enquiry',
    },
  },
];

// Atelier — the custom build. Deliberately not numbered: it is not a fifth
// instrument, it is the workshop behind the four.
const atelier = {
  de: {
    eyebrow: 'Individuell gebaut',
    role: 'Passt keines der vier? Dann bauen wir es.',
    body: 'Manche Häuser arbeiten anders — und sollen sich nicht verbiegen, damit eine Software passt. Das Atelier baut um Ihren Betrieb herum, auf demselben Fundament wie die vier Instrumente. Zu einem Preis, der zu einem Gastrobetrieb passt, nicht zu einem Konzern.',
    action: 'Gespräch anfragen',
    subject: 'Anfrage Atelier',
  },
  en: {
    eyebrow: 'Custom-built',
    role: 'None of the four fits? Then we build it.',
    body: 'Some houses run differently — and should not bend themselves to fit a piece of software. The Atelier builds around your operation, on the same foundation as the four instruments. At a price that fits a hospitality business, not a corporation.',
    action: 'Request a conversation',
    subject: 'Atelier enquiry',
  },
};

const instruments = [
  {
    accent: 'var(--aurora)', roman: 'I', href: '/aurora',
    name: 'Aurora',
    de: { eyebrow: 'Kasse & Umsatz', hero: 'Kasse, die mitdenkt.', role: 'Vom Bon bis zum Deckungsbeitrag.', body: 'Bestellen, kassieren, abschliessen. Aurora führt Tische, rechnet Schichten ab und schliesst die Kasse — ruhig, ob das Lokal leer ist oder voll. Für die Gastronomie gebaut, nicht aus einer Retail-Kasse abgeleitet.' },
    en: { eyebrow: 'Point of sale', hero: 'Next-gen revenue & sales POS.', role: 'The cash register, reimagined.', body: 'Order, charge, settle. Aurora reads tabs, totals shifts, and closes the till — with the same calm whether the room is empty or six-deep. Built for hospitality first, not adapted from a retail POS.' },
  },
  {
    accent: 'var(--nova)', roman: 'II', href: '/nova',
    name: 'Nova',
    de: { eyebrow: 'Dienstplanung', hero: 'Der Plan, der sich selbst tauscht.', role: 'Der Plan, der die Woche übersteht.', body: 'Schichten, Bewerbungen und das tägliche Organisieren eines Gastro-Teams. Konflikte zeigen sich, bevor sie zubeissen; der Plan hält. Für alle, die nie Dienstplaner werden wollten.' },
    en: { eyebrow: 'Staffing loop', hero: 'Every shift in its orbit.', role: 'The schedule that survives the week.', body: 'Shifts, applications, and the daily orchestration of a hospitality team. Conflicts surface before they bite; the calendar holds. For managers who never wanted to be schedulers.' },
  },
  {
    accent: 'var(--zenith)', roman: 'III', href: '/zenith',
    name: 'Zenith',
    de: { eyebrow: 'Hygiene & HACCP', hero: 'Die Kontrolle kommt. Ihr Nachweis ist bereit.', role: 'HACCP-Doku, die nicht gegen Sie arbeitet.', body: 'Temperaturen, Reinigungskontrollen, Wareneingänge — ein ruhiger Fluss. Jeden Tag prüfungsbereit, nicht erst am Abend vor der Kontrolle. Die Doku, ohne den Papierkram.' },
    en: { eyebrow: 'Hygiene & compliance', hero: 'Your kitchen’s true north.', role: 'HACCP logging that doesn’t fight you.', body: 'Temperatures, cleaning checks, supplier batches — one quiet feed. Audit-ready every day, not the night before the inspector arrives. The paperwork, without the paper.' },
  },
  {
    accent: 'var(--ceres)', roman: 'IV', href: '/ceres',
    name: 'Ceres',
    de: { eyebrow: 'Menü & Einkauf', hero: 'Plan für 200. Bestellung für genau 200.', role: 'Die Rechnung vom Plan zur Bestellung.', body: 'Menüs, Rezepte und die Mathematik dazwischen. Pax eintragen — Ceres skaliert jedes Gericht und rechnet die Bestellung pro Lieferant. Nichts zu viel vorbereitet, nichts zu viel bestellt.' },
    en: { eyebrow: 'Menu & production', hero: 'From harvest to plate, planned.', role: 'The prep list that counts itself.', body: 'Menus, recipes, and the maths between them. Set the cover count and Ceres scales every dish, then writes the supplier order itself — nothing over-prepped, nothing over-bought.' },
  },
];

const t = C[lang];
const a = atelier[lang];
const pre = lang === 'en' ? '/en' : '';
const mailto = (subject) => `mailto:${MAIL}?subject=${encodeURIComponent(subject)}`;
---
<main id="main" class="home-stage">
  <section class="composition">
    <Backdrop alt={t.backdropAlt} />
    <div class="composition-inner">
      <Mark size={96} draw={true} />
      <h1 class="wordmark" translate="no">TRIARC</h1>
      <div class="hairline-row">
        <span class="hairline" aria-hidden="true"></span>
        <span class="est">EST · CH · MMXXVI</span>
        <span class="hairline" aria-hidden="true"></span>
      </div>
      <p class="tagline">{t.tagline[0]}<br />{t.tagline[1]}</p>
      <div class="status">
        <div class="pulse" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="status-label">{t.status}</span>
      </div>

      <a class="scroll-cue" href="#services">
        <span class="cue-label">{t.inspect}</span>
        <span class="cue-line" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <section id="services" class="services-case" tabindex="-1">
    <div class="peek-header reveal">
      <span class="rule" aria-hidden="true"></span>
      <span class="label">{t.servicesLabel}</span>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <p class="peek-lede reveal">{t.servicesLede} <span class="accent">{t.servicesLedeAccent}</span></p>

    <div class="services">
      {services.map((svc, i) => (
        <article class="service reveal" style={`--delay:${i * 90}ms`}>
          <div class="accent-rule" aria-hidden="true"></div>
          <span class="eyebrow"><span class="roman">{svc.roman}</span>{svc[lang].eyebrow}</span>
          <h2 class="name">{svc[lang].name}<span class="stop">.</span></h2>
          <p class="role">{svc[lang].role}</p>
          <p class="body">{svc[lang].body}</p>
          <a
            class="action"
            href={svc.href ?? mailto(svc.subject[lang])}
            data-jump={svc.href ? 'instruments' : undefined}
          >{svc[lang].action}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="instruments" class="instrument-case" tabindex="-1">
    <div class="peek-header reveal">
      <span class="rule" aria-hidden="true"></span>
      <span class="label">{t.instrumentsLabel}</span>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <p class="peek-lede reveal">{t.lede}</p>

    <div class="instruments">
      {instruments.map((inst, i) => (
        <article class="instrument reveal" style={`--accent:${inst.accent}; --delay:${i * 90}ms`}>
          <div class="accent-rule" aria-hidden="true"></div>
          <span class="eyebrow"><span class="roman">{inst.roman}</span>{inst[lang].eyebrow}</span>
          <h2 class="name"><a href={pre + inst.href}><span translate="no">{inst.name}</span><span class="stop">.</span></a></h2>
          <p class="hero">{inst[lang].hero}</p>
          <p class="role">{inst[lang].role}</p>
          <p class="body">{inst[lang].body}</p>
          <a class="detail-link" href={pre + inst.href}>{t.more}</a>
        </article>
      ))}
    </div>

    <aside class="atelier reveal">
      <div class="atelier-head">
        <span class="eyebrow">{a.eyebrow}</span>
        <h2 class="name" translate="no">Atelier<span class="stop">.</span></h2>
      </div>
      <div class="atelier-body">
        <p class="role">{a.role}</p>
        <p class="body">{a.body}</p>
        <a class="detail-link" href={mailto(a.subject)}>{a.action}</a>
      </div>
    </aside>
  </section>
</main>

<script>
  // The cue scrolls to the services; it also fades out once they are in view,
  // so it never competes with what it pointed at. The Software card jumps on
  // down to the instrument case with the same smooth-scroll + focus handoff.
  const smoothJump = (el, targetId) => {
    const target = document.getElementById(targetId);
    if (!target) return;
    el.addEventListener('click', (e) => {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // hand focus to what the link pointed at, so keyboard users follow along
      target.focus({ preventScroll: true });
    });
  };

  const cue = document.querySelector('.scroll-cue');
  if (cue) {
    smoothJump(cue, 'services');
    let queued = false;
    const sync = () => {
      queued = false;
      cue.classList.toggle('gone', window.scrollY > 80);
    };
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; window.requestAnimationFrame(sync); }
    }, { passive: true });
    sync();
  }

  document.querySelectorAll('[data-jump]').forEach((el) => {
    smoothJump(el, el.getAttribute('data-jump'));
  });
</script>

<style>
  /* the hero runs full-bleed, so respect the notch on landscape iPhones */
  .home-stage { display: flex; flex-direction: column; align-items: center; padding: 0 max(32px, env(safe-area-inset-left)) 8px max(32px, env(safe-area-inset-right)); }

  /* the hero is a stage: it owns the viewport, with the ridge on its floor */
  .composition {
    position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 100%;
    min-height: clamp(500px, calc(100svh - 168px), 740px);
    padding: 8px 0 40px;
  }
  .composition-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 32px; max-width: 540px; width: 100%; }
  .wordmark { font-family: var(--sans); font-weight: 400; font-size: clamp(44px, 8.4vw, 88px); letter-spacing: 0.4em; text-indent: 0.4em; color: var(--ink); line-height: 1; margin: 0; }
  .hairline-row { display: flex; align-items: center; gap: 18px; width: 100%; max-width: 360px; }
  .hairline { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .est { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); white-space: nowrap; }
  .tagline { font-family: var(--serif); font-weight: 300; font-style: italic; font-size: clamp(20px, 2.6vw, 26px); line-height: 1.35; text-align: center; text-wrap: balance; color: var(--ink); margin: 0; max-width: 600px; }
  /* the lockup now sits on the massif — these three lines carry a paper halo
     so they read over snow in either theme */
  .est, .status-label { text-shadow: 0 0 4px var(--paper), 0 0 10px var(--paper), 0 0 22px var(--paper); }
  .tagline { text-shadow: 0 0 6px var(--paper), 0 0 14px var(--paper), 0 0 30px var(--paper), 0 0 50px var(--paper); }
  .status { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .status-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--ink-soft); }
  .pulse { display: flex; gap: 6px; align-items: center; }
  .pulse span { width: 24px; height: 1px; background: var(--gold); opacity: 0.4; animation: pulse 2.4s ease-in-out infinite; }
  .pulse span:nth-child(2) { animation-delay: 0.3s; }
  .pulse span:nth-child(3) { animation-delay: 0.6s; }
  @keyframes pulse { 0%, 100% { opacity: 0.25; transform: scaleX(0.7); } 50% { opacity: 1; transform: scaleX(1); } }

  /* scroll cue — a hairline dropping toward the choice. In normal flow, so the
     hero never has to reserve empty space underneath it. */
  .scroll-cue {
    margin-top: 4px;
    z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 14px;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.36em; text-indent: 0.36em;
    text-transform: uppercase; color: var(--ink-soft);
    transition: color 240ms ease, opacity 420ms ease, transform 420ms var(--ease);
  }
  /* a halo that hugs the glyphs, so the label stays legible over the massif
     without putting a box on the photograph */
  .cue-label { text-shadow: 0 0 3px var(--paper), 0 0 8px var(--paper), 0 0 16px var(--paper), 0 0 30px var(--paper); }
  .scroll-cue:hover { color: var(--gold); }
  .scroll-cue.gone { opacity: 0; transform: translateY(8px); pointer-events: none; }
  /* the hairline is the actual affordance — it needs the same halo as the
     label to survive over lit snow */
  .cue-line { width: 1px; height: 42px; background: linear-gradient(180deg, var(--gold), transparent); opacity: 0.7; transform-origin: top; filter: drop-shadow(0 0 5px var(--paper)) drop-shadow(0 0 10px var(--paper)); animation: cue-drop 2.8s var(--ease) infinite; }
  @keyframes cue-drop {
    0%, 100% { transform: scaleY(0.55); opacity: 0.35; }
    45% { transform: scaleY(1); opacity: 0.9; }
  }

  /* the two cases share the frame; only their contents differ */
  .services-case, .instrument-case { position: relative; z-index: 1; width: 100%; max-width: 1100px; margin: 0 auto; padding-top: clamp(20px, 3vh, 40px); scroll-margin-top: 24px; }
  .instrument-case { padding-top: clamp(64px, 9vh, 120px); }
  .services-case:focus, .instrument-case:focus { outline: none; }
  .services-case:focus-visible, .instrument-case:focus-visible { outline: 1px solid var(--gold); outline-offset: 12px; }

  .peek-header { display: flex; align-items: center; gap: 18px; justify-content: center; padding: 0 24px 36px; }
  .peek-header .rule { flex: 1; max-width: 120px; height: 1px; background: var(--rule); }
  .peek-header .label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.36em; text-transform: uppercase; color: var(--ink-soft); }
  .peek-lede { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(18px, 2.2vw, 25px); line-height: 1.4; text-align: center; text-wrap: pretty; color: var(--ink); max-width: 30em; margin: 0 auto 48px; }
  .peek-lede .accent { color: var(--gold); font-style: normal; }

  /* the three services — panelled, so the choice reads as the first decision;
     the instruments below stay borderless and lighter */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 0 24px; align-items: stretch; }
  .service {
    display: flex; flex-direction: column; gap: 14px;
    padding: 30px 30px 32px; border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper-deep) 55%, transparent);
    transition: border-color 320ms var(--ease), transform 320ms var(--ease);
  }
  .service:hover { border-color: color-mix(in srgb, var(--gold) 55%, transparent); transform: translateY(-3px); }
  .service .accent-rule { width: 100%; height: 2px; background: var(--gold); margin-bottom: 4px; transform: scaleX(0.2); transform-origin: left center; transition: transform 420ms var(--ease); }
  .service:hover .accent-rule { transform: scaleX(1); }
  .service .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); }
  .service .eyebrow .roman { color: var(--gold); margin-right: 8px; }
  .service .name { font-family: var(--serif); font-weight: 300; font-size: clamp(32px, 3.4vw, 42px); line-height: 0.98; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
  .service .name .stop { color: var(--gold); }
  .service .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 17px; color: var(--gold); margin: 0; line-height: 1.3; text-wrap: balance; }
  .service .body { font-size: 14px; line-height: 1.65; color: var(--ink); margin: 2px 0 0; text-wrap: pretty; }
  .service .action { align-self: flex-start; margin-top: auto; padding: 12px 0 3px; border-bottom: 1px solid var(--gold); font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); transition: color 180ms ease; }
  .service .action:hover { color: var(--gold); }

  .instruments { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; padding: 0 24px 24px; }
  .instrument { display: flex; flex-direction: column; gap: 14px; transition: transform 320ms var(--ease); }
  .instrument:hover { transform: translateY(-3px); }
  /* the rule extends on hover via transform, not width — width would relayout
     the card on every frame */
  .instrument .accent-rule { width: 100%; height: 2px; background: var(--accent); margin-bottom: 4px; transform: scaleX(0.155); transform-origin: left center; transition: transform 420ms var(--ease); }
  .instrument:hover .accent-rule { transform: scaleX(1); }
  .instrument .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); }
  .instrument .eyebrow .roman { color: var(--accent); margin-right: 8px; }
  .instrument .hero { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); line-height: 1.4; margin: -4px 0 0; }
  .instrument .name { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4vw, 48px); line-height: 0.95; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
  .instrument .name a { transition: opacity 160ms ease; }
  .instrument .name a:hover { opacity: 0.7; }
  .instrument .name .stop { color: var(--accent); }
  .instrument .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 16px; color: var(--ink-soft); margin: 0; line-height: 1.3; }
  .instrument .body { font-size: 14px; line-height: 1.65; color: var(--ink); margin: 6px 0 0; max-width: 32ch; }
  .instrument .detail-link { align-self: flex-start; margin-top: 4px; padding: 8px 0 3px; border-bottom: 1px solid var(--accent); font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); transition: color 180ms ease; }
  .instrument .detail-link:hover { color: var(--accent); }

  /* the atelier closes the case: no roman numeral, no accent colour of its own —
     it is the workshop behind the four, not a fifth instrument */
  .atelier {
    display: grid; grid-template-columns: minmax(200px, 1fr) 2fr; gap: 32px 48px;
    margin: 12px 24px clamp(28px, 5vh, 64px); padding: 34px 0 0; border-top: 1px solid var(--rule);
  }
  .atelier .eyebrow { display: block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
  .atelier .name { font-family: var(--serif); font-weight: 300; font-size: clamp(34px, 3.6vw, 44px); line-height: 0.95; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
  .atelier .name .stop { color: var(--gold); }
  .atelier-body { display: flex; flex-direction: column; gap: 12px; }
  .atelier .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 19px; color: var(--ink); margin: 0; line-height: 1.3; }
  .atelier .body { font-size: 14px; line-height: 1.7; color: var(--ink-soft); margin: 0; max-width: 62ch; }
  .atelier .detail-link { align-self: flex-start; margin-top: 6px; padding: 8px 0 3px; border-bottom: 1px solid var(--gold); font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); transition: color 180ms ease; }
  .atelier .detail-link:hover { color: var(--gold); }

  /* staggered reveal for the cards */
  :global(.js) .service.reveal,
