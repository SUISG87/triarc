---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';

const mailto = "mailto:manuel@triarc.ch?subject=Triarc%20%E2%80%93%20Enquiry&body=Business%3A%0ALocations%3A%0ACurrent%20system%3A%0A";

const stations = [
  { yr: '2023 — today', place: 'CDS Enterprise · Interim Managing Director', what: 'Overall responsibility for strategy, operations and finance. Hospitality consulting plus interim and emergency mandates (Executive Chef, Head of F&B, Operations) — including for Viking Expeditions and Sea Cloud II, Six Senses, Hyatt, private luxury boutique hotels and European mountain resorts; international cover assignments in the Philippines and the Middle East.' },
  { yr: '2023', place: "Hotel Schweizerhof Bern, Bürgenstock Collection ★★★★★ · Executive Chef", what: "Led all culinary outlets incl. Jack's Brasserie (14 GaultMillau points), Sky Terrace and events; 35 staff." },
  { yr: '2021 — 2023', place: 'Waldhaus Flims Wellness Resort ★★★★★ · Executive Chef', what: '45 staff across 10 outlets. Awarded under his leadership: the Epoca with a Michelin star and 17 GaultMillau points, the Siam with 14 GaultMillau points. Digitised the hygiene and purchasing systems.' },
  { yr: '2019 — 2021', place: 'Kongresszentrum Davos · Executive Chef & Head of F&B', what: 'Multi-outlet F&B and large events incl. the World Economic Forum (WEF). Catering for up to 5,000 people, ISO 9001/14001, HACCP. Teams of up to 80.' },
  { yr: '2017 — 2019', place: 'Grand Hyatt Manila ★★★★★ · Chef de Cuisine, Pre-Opening', what: 'Opening team of a 7-outlet luxury hotel; developed signature concepts and banquet operations. The steakhouse was twice named best steakhouse in the Philippines.' },
  { yr: '2015 — 2017', place: 'Rocco Forte · Jeddah, Saudi Arabia ★★★★★ · Chef de Cuisine, Pre-Opening', what: 'Opening team of a luxury house; built up kitchen operations and banqueting.' },
  { yr: '2012 — 2015', place: 'The Globe · Al Faisaliah (Rosewood), Riyadh ★★★★★ · Chef de Cuisine', what: 'Led the award-winning fine-dining restaurant The Globe — twice named best fine-dining restaurant (Saudi Tourism). VIP and royal events for up to 5,000 people.' },
  { yr: '2010 — 2012', place: 'Trump International Golf Links · Ireland ★★★★★ · Sous Chef', what: 'First international posting. Led fine-dining restaurants and banquet operations — named best hotel fine dining (Irish Hotels Association).' },
  { yr: '2007 — 2010', place: 'Early Career · Commis to Chef de Partie', what: 'Switzerland and cruise — Michelin and fine-dining houses, luxury hotels, banqueting.' },
];

const instruments = [
  { href: '/en/aurora', ac: 'var(--aurora)', name: 'Aurora', role: 'POS & revenue control' },
  { href: '/en/nova', ac: 'var(--nova)', name: 'Nova', role: 'Staff scheduling' },
  { href: '/en/zenith', ac: 'var(--zenith)', name: 'Zenith', role: 'HACCP & hygiene' },
  { href: '/en/ceres', ac: 'var(--ceres)', name: 'Ceres', role: 'Menu planning & purchasing' },
];
---
<Base
  title="The Founder — Manuel Bänziger | Triarc"
  description="Triarc was founded by Manuel Bänziger — an Executive Chef and F&B leader with over 20 years of international fine-dining experience. Hospitality software from someone who knows operations from the inside."
  lang="en"
  crumb="The Founder"
  ogType="profile"
  altHref="/gruender"
>
  <main>
    <section class="hero">
      <div>
        <Mark size={72} />
        <p class="g-eyebrow"><span class="roman">—</span>The Founder</p>
        <h1 class="g-h1">Manuel<br />Bänziger<span class="stop">.</span></h1>
      </div>
      <div>
        <p class="section-kicker">Hospitality software from someone who stood at the pass.</p>
        <p class="role">Built by a chef, not by a software company.</p>
        <p class="narrative">Triarc was founded by Manuel Bänziger, an Executive Chef and F&amp;B leader with over twenty years in international fine dining. He has run acclaimed five-star houses — from Switzerland through the Middle East to Asia — led teams of up to 80 and taken charge of large events for up to 5,000 people. Today he advises and runs hospitality operations. In every one of these roles he fought the same tools: Excel, paper, software no one had ever tested at the pass. <strong>So he built the instruments he wished he'd had.</strong></p>
      </div>
    </section>

    <section class="creds reveal" aria-label="Awards and qualifications">
      <div class="cred"><div class="v">20<span class="stop">+</span></div><div class="k">Years' experience</div></div>
      <div class="cred"><div class="v">5<span class="stop">★</span></div><div class="k">International houses</div></div>
      <div class="cred"><div class="v">3</div><div class="k">Continents</div></div>
      <div class="cred"><div class="v">Lvl 4</div><div class="k">HACCP certification</div></div>
    </section>

    <section class="thesis reveal">
      <div>
        <p class="section-kicker">Why Triarc</p>
        <p class="pull">Whoever knows the problem builds the better solution.</p>
      </div>
      <div>
        <p class="body">Most hospitality software is built by people who have never run a shift, never checked a delivery, never closed a till at midnight. You feel it in every feature.</p>
        <p class="body">Triarc turns that around. Each of the four instruments solves a problem Manuel had in real operations — as a chef, as Head of F&amp;B, as the operator responsible for budget, KPIs and HACCP. <strong>No feature without a lived reason.</strong></p>
        <p class="body">The result is software that is right-sized: deep where it counts — the audit proof, the contribution margin, the rota — and lean everywhere else.</p>
        <p class="body"><strong>And nothing off the shelf.</strong> You tell us how your business works — we find the right instrument and set it up around you. If something's missing, we build it around your needs. One solution per problem and per house, not one for everyone.</p>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Career</p>
      <div class="cv">
        {stations.map((s) => (
          <div class="station">
            <span class="yr">{s.yr}</span>
            <div>
              <p class="place" set:html={s.place.replace('★★★★★', '<span class="star">★★★★★</span>')}></p>
              <p class="what" set:html={s.what}></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Large events &amp; guests</p>
      <p class="pull" style="margin-bottom:26px;">From the pass to the state banquet.</p>
      <p class="g-prose">Over two decades, Manuel has planned and orchestrated events for up to <strong>5,000 guests</strong> — from royal weddings at the Saudi court to state receptions and delegations at the World Economic Forum in Davos.</p>
      <p class="g-prose" style="margin:0;">Guests served have included heads of state and international figures — among them <strong>Bill Clinton</strong>, <strong>Barack Obama</strong>, <strong>Donald Trump</strong>, <strong>Angela Merkel</strong> and <strong>The Rolling Stones</strong> — and many other globally known figures we do not name, for reasons of confidentiality (NDAs) and to protect their privacy.</p>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Awards</p>
      <p class="pull" style="margin-bottom:30px;">Awarded under his leadership.</p>
      <div class="edu-grid">
        <div class="edu">
          <h3>Switzerland</h3>
          <ul class="list">
            <li><strong>Epoca</strong>, Waldhaus Flims — 1 Michelin star and 17 GaultMillau points</li>
            <li><strong>Siam</strong>, Waldhaus Flims — 14 GaultMillau points</li>
            <li><strong>Jack&rsquo;s Brasserie</strong>, Hotel Schweizerhof Bern — 14 GaultMillau points</li>
          </ul>
        </div>
        <div class="edu">
          <h3>International</h3>
          <ul class="list">
            <li><strong>The Globe</strong>, Riyadh — twice named best fine-dining restaurant (Saudi Tourism · 2012 &amp; 2013)</li>
            <li><strong>Trump International</strong>, Ireland — best hotel fine dining (Irish Hotels Association · 2011)</li>
            <li><strong>Grand Hyatt Manila</strong> — twice named best steakhouse in the Philippines</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">Education &amp; training</p>
      <div class="edu-grid">
        <div class="edu">
          <h3>Education</h3>
          <ul class="list">
            <li>Federally certified Hotel Manager HF (NDS), Hotelfachschule Thun — in progress (2027)</li>
            <li>Federally certified Head Chef &amp; Production Manager (2026)</li>
            <li>Chef with Federal Diploma (EFA) (2025)</li>
            <li>Chef EFZ, Restaurant David 38, St. Gallen (2004–2007) — 15 GaultMillau points</li>
          </ul>
        </div>
        <div class="edu">
          <h3>Continuing education</h3>
          <ul class="list">
            <li>Cornell University — Executive Education, Food &amp; Beverage Management (2025)</li>
            <li>Cornell University — Hotel Management 360, Executive Education</li>
            <li>Harvard ManageMentor — Harvard Business School (2015)</li>
            <li>HACCP Level 4 (2023), Level 3 (2018), Level 1 (2015)</li>
            <li>HACCP Auditor</li>
            <li>ISO 14001 Auditor (environmental management)</li>
            <li>SHIPSAN certified (ship hygiene / public health)</li>
            <li>USPH trained (Vessel Sanitation Program)</li>
            <li>Crisis management &amp; human behaviour (2024)</li>
            <li>STCW 95 — basic safety training, seagoing (2024)</li>
            <li>Security awareness for seafarers (2024)</li>
            <li>Vocational trainer (Berufsbildner, 2009)</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="block reveal">
      <p class="section-kicker">The four instruments</p>
      <div class="instruments-row">
        {instruments.map((i) => (
          <a class="inst" href={i.href} style={`--ac:${i.ac}`}>
            <div class="ar" aria-hidden="true"></div>
            <h3>{i.name}<span class="stop">.</span></h3>
            <p>{i.role}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="cta-band reveal">
      <h2>Talk to the person who built it.</h2>
      <p>No sales team, no call centre — straight to the founder. Tell us how your business works and we'll figure out which instrument fits.</p>
      <p class="contact-line dim">Swiss data protection · data in CH/EU, revDSG-compliant · no lock-in contract · setup personally guided</p>
      <a class="btn" href={mailto}>Get in touch →</a>
      <p class="contact-line">Direct: <a href="mailto:manuel@triarc.ch">manuel@triarc.ch</a></p>
    </section>
  </main>
</Base>

<style>
  main { width: min(1080px, calc(100% - 64px)); margin: 0 auto; padding: 18px 0 24px; }
  .hero { display: grid; grid-template-columns: minmax(260px, 0.7fr) minmax(320px, 1fr); gap: clamp(40px, 7vw, 90px); align-items: end; padding: 30px 0 50px; border-bottom: 1px solid var(--rule); }
  .hero :global(.mark) { margin-bottom: 28px; }
  .g-eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 14px; }
  .g-eyebrow .roman { color: var(--gold); margin-right: 10px; }
  .g-h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(52px, 8vw, 104px); line-height: 0.9; letter-spacing: -0.01em; margin: 0; }
  .g-h1 .stop { color: var(--gold); }
  .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(22px, 2.8vw, 32px); line-height: 1.22; margin: 0 0 22px; color: var(--ink); }
  .narrative { font-size: 16.5px; line-height: 1.78; color: var(--ink); margin: 0; max-width: 42rem; }
  .narrative strong { font-weight: 500; }

  .creds { display: flex; flex-wrap: wrap; gap: 0; padding: 40px 0; border-bottom: 1px solid var(--rule); }
  .cred { flex: 1 1 auto; min-width: 140px; padding: 4px 28px 4px 0; margin-right: 28px; border-right: 1px solid var(--rule); }
  .cred:last-child { border-right: 0; }
  .cred .v { font-family: var(--serif); font-size: clamp(26px, 3vw, 38px); line-height: 1; color: var(--ink); }
  .cred .v .stop { color: var(--gold); }
  .cred .k { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); margin-top: 9px; }

  .thesis { padding: 56px 0; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(38px, 6vw, 76px); }
  .thesis .body { margin: 0 0 16px; font-size: 16px; line-height: 1.72; color: var(--ink); }
  .thesis .body:last-child { margin-bottom: 0; }
  .thesis .body strong { font-weight: 500; }

  .block { padding: 56px 0; border-bottom: 1px solid var(--rule); }
  .block > .section-kicker { margin-bottom: 30px; }
  .g-prose { font-size: 16px; line-height: 1.72; color: var(--ink); max-width: 44rem; margin: 0 0 16px; }
  .g-prose strong { font-weight: 500; }

  .cv { display: grid; gap: 0; }
  .station { display: grid; grid-template-columns: 130px 1fr; gap: 28px; padding: 20px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .station:first-child { border-top: 0; padding-top: 0; }
  .station .yr { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: var(--gold); }
  .station .place { font-family: var(--sans); font-weight: 500; font-size: 16px; margin: 0 0 4px; }
  .station .place :global(.star) { color: var(--gold); font-size: 12px; }
  .station .what { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }

  .edu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 56px; }
  .edu h3 { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 16px; font-weight: 400; }
  .list { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
  .list li { position: relative; padding-left: 20px; font-size: 14.5px; line-height: 1.55; color: var(--ink); }
  .list li::before { content: ""; position: absolute; left: 0; top: 0.68em; width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }
  .list strong { font-weight: 500; }

  .instruments-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .inst { padding: 22px 20px 24px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); transition: background 180ms ease; }
  .inst:hover { background: var(--paper-deep); }
  .inst .ar { width: 26px; height: 2px; background: var(--ac); margin-bottom: 12px; }
  .inst h3 { font-family: var(--serif); font-weight: 400; font-size: 22px; margin: 0 0 4px; }
  .inst h3 .stop { color: var(--ac); }
  .inst p { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--ink-soft); }

  .cta-band { margin: 64px 0 8px; padding: clamp(46px, 7vw, 80px) clamp(28px, 5vw, 64px); background: var(--paper-deep); border-top: 1px solid var(--gold); border-bottom: 1px solid var(--gold); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .cta-band h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(28px, 4vw, 50px); line-height: 1.05; margin: 0; max-width: 16em; }
  .cta-band p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--ink-soft); max-width: 40rem; }
  .contact-line { font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-soft); }
  .contact-line.dim { opacity: 0.85; }
  .contact-line a { color: var(--ink); border-bottom: 1px solid var(--gold); padding-bottom: 2px; }
  .contact-line a:hover { color: var(--gold); }

  @media (max-width: 900px) { .instruments-row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 820px) {
    main { width: min(100% - 44px, 660px); }
    .hero { grid-template-columns: 1fr; gap: 26px; padding-top: 24px; }
    .thesis { grid-template-columns: 1fr; gap: 26px; }
    .station { grid-template-columns: 1fr; gap: 5px; }
    .edu-grid { grid-template-columns: 1fr; gap: 28px; }
    .creds { gap: 18px 0; }
    .cred { flex: 1 1 45%; border-right: 0; padding-right: 0; margin-right: 0; }
  }
  @media (max-width: 480px) { .instruments-row { grid-template-columns: 1fr; } .btn { width: 100%; justify-content: center; } }
</style>
