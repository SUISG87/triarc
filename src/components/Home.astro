---
import Mark from './Mark.astro';
const { lang = 'de' } = Astro.props;

const C = {
  de: {
    tagline: ['Vier Instrumente.', 'Eine Betriebsschicht.'],
    status: 'Im Aufbau · Anfragen offen',
    inspect: 'Instrumente ansehen',
    close: 'Schliessen',
    instrumentsLabel: 'Vier Instrumente',
    lede: 'Keine Lösung für alle. Sagen Sie uns, wie Ihr Haus arbeitet — wir finden das richtige Instrument und richten es auf Sie ein. Und passt keines der vier,',
    ledeAccent: 'bauen wir, was Sie brauchen.',
    more: 'Mehr erfahren',
  },
  en: {
    tagline: ['Swiss-engineered instruments', 'for hospitality.'],
    status: 'In build · Open for enquiries',
    inspect: 'Inspect the instruments',
    close: 'Close the case',
    instrumentsLabel: 'Four instruments',
    lede: 'Not one application for everyone. Tell us how your house runs — we find the right instrument and shape it around your work. And if none of the four fits,',
    ledeAccent: 'we build what you need.',
    more: 'Read the instrument',
  },
};

const instruments = [
  {
    accent: 'var(--aurora)', roman: 'I', href: '/aurora',
    name: 'Aurora',
    de: { eyebrow: 'Kasse & Umsatz', hero: 'Kasse, die mitdenkt.', role: 'Vom Bon bis zum Deckungsbeitrag.', body: 'Bestellen, kassieren, abschliessen. Aurora führt Tische, rechnet Schichten ab und schliesst die Kasse — ruhig, ob das Lokal leer ist oder voll. Für die Gastronomie gebaut, nicht aus einer Retail-Kasse abgeleitet.' },
    en: { eyebrow: 'Point of sale', hero: 'Next-gen revenue & sales POS.', role: 'The cash register, reimagined.', body: 'Order, charge, settle. Aurora reads tabs, totals shifts, and closes the till — with the same calm whether the room is empty or six-deep. Built for hospitality first, not adapted from a retail POS.' },
  },
  {
    accent: 'var(--nova)', roman: 'II', href: '/nova',
    name: 'Nova',
    de: { eyebrow: 'Dienstplanung', hero: 'Der Plan, der sich selbst tauscht.', role: 'Der Plan, der die Woche übersteht.', body: 'Schichten, Bewerbungen und das tägliche Organisieren eines Gastro-Teams. Konflikte zeigen sich, bevor sie zubeissen; der Plan hält. Für alle, die nie Dienstplaner werden wollten.' },
    en: { eyebrow: 'Staffing loop', hero: 'Every shift in its orbit.', role: 'The schedule that survives the week.', body: 'Shifts, applications, and the daily orchestration of a hospitality team. Conflicts surface before they bite; the calendar holds. For managers who never wanted to be schedulers.' },
  },
  {
    accent: 'var(--zenith)', roman: 'III', href: '/zenith',
    name: 'Zenith',
    de: { eyebrow: 'Hygiene & HACCP', hero: 'Die Kontrolle kommt. Ihr Nachweis ist bereit.', role: 'HACCP-Doku, die nicht gegen Sie arbeitet.', body: 'Temperaturen, Reinigungskontrollen, Wareneingänge — ein ruhiger Fluss. Jeden Tag prüfungsbereit, nicht erst am Abend vor der Kontrolle. Die Doku, ohne den Papierkram.' },
    en: { eyebrow: 'Hygiene & compliance', hero: "Your kitchen's true north.", role: "HACCP logging that doesn't fight you.", body: 'Temperatures, cleaning checks, supplier batches — one quiet feed. Audit-ready every day, not the night before the inspector arrives. The paperwork, without the paper.' },
  },
  {
    accent: 'var(--ceres)', roman: 'IV', href: '/ceres',
    name: 'Ceres',
    de: { eyebrow: 'Menü & Einkauf', hero: 'Plan für 200. Bestellung für genau 200.', role: 'Die Rechnung vom Plan zur Bestellung.', body: 'Menüs, Rezepte und die Mathematik dazwischen. Pax eintragen — Ceres skaliert jedes Gericht und rechnet die Bestellung pro Lieferant. Nichts zu viel vorbereitet, nichts zu viel bestellt.' },
    en: { eyebrow: 'Menu & production', hero: 'From harvest to plate, planned.', role: 'The prep list that counts itself.', body: 'Menus, recipes, and the maths between them. Set the cover count and Ceres scales every dish, then writes the supplier order itself — nothing over-prepped, nothing over-bought.' },
  },
];

const t = C[lang];
const pre = lang === 'en' ? '/en' : '';
---
<main class="home-stage">
  <section class="composition">
    <Mark size={96} />
    <h1 class="wordmark">TRIARC</h1>
    <div class="hairline-row">
      <span class="hairline" aria-hidden="true"></span>
      <span class="est">EST · CH · MMXXVI</span>
      <span class="hairline" aria-hidden="true"></span>
    </div>
    <p class="tagline">{t.tagline[0]}<br />{t.tagline[1]}</p>
    <div class="status">
      <div class="pulse" aria-hidden="true"><span></span><span></span><span></span></div>
      <span class="status-label">{t.status}</span>
    </div>

    <button class="peek-trigger" type="button" aria-expanded="false" aria-controls="peek-panel">
      <span class="label-open">{t.inspect}</span>
      <span class="label-close">{t.close}</span>
    </button>
  </section>

  <section id="peek-panel" class="peek-panel" aria-hidden="true">
    <div class="peek-header">
      <span class="rule" aria-hidden="true"></span>
      <span class="label">{t.instrumentsLabel}</span>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <p class="peek-lede">{t.lede} <span class="accent">{t.ledeAccent}</span></p>

    <div class="instruments">
      {instruments.map((inst) => (
        <article class="instrument" style={`--accent:${inst.accent}`}>
          <div class="accent-rule" aria-hidden="true"></div>
          <span class="eyebrow"><span class="roman">{inst.roman}</span>{inst[lang].eyebrow}</span>
          <h2 class="name"><a href={pre + inst.href}>{inst.name}<span class="stop">.</span></a></h2>
          <p class="hero">{inst[lang].hero}</p>
          <p class="role">{inst[lang].role}</p>
          <p class="body">{inst[lang].body}</p>
          <a class="detail-link" href={pre + inst.href}>{t.more}</a>
        </article>
      ))}
    </div>
  </section>
</main>

<script>
  const trigger = document.querySelector('.peek-trigger');
  const panel = document.getElementById('peek-panel');
  if (trigger && panel) {
    trigger.addEventListener('click', () => {
      const open = panel.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      if (open) {
        window.setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 200);
      }
    });
  }
</script>

<style>
  .home-stage { display: flex; flex-direction: column; align-items: center; padding: 24px 32px 8px; }
  .composition { display: flex; flex-direction: column; align-items: center; gap: 32px; max-width: 540px; width: 100%; padding: 16px 0 8px; }
  .wordmark { font-family: var(--sans); font-weight: 400; font-size: clamp(40px, 7vw, 64px); letter-spacing: 0.42em; text-indent: 0.42em; color: var(--ink); line-height: 1; margin: 0; }
  .hairline-row { display: flex; align-items: center; gap: 18px; width: 100%; max-width: 360px; }
  .hairline { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .est { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); white-space: nowrap; }
  .tagline { font-family: var(--serif); font-weight: 300; font-style: italic; font-size: clamp(20px, 2.6vw, 26px); line-height: 1.35; text-align: center; color: var(--ink); margin: 0; max-width: 480px; }
  .status { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .status-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--ink-soft); }
  .pulse { display: flex; gap: 6px; align-items: center; }
  .pulse span { width: 24px; height: 1px; background: var(--gold); opacity: 0.4; animation: pulse 2.4s ease-in-out infinite; }
  .pulse span:nth-child(2) { animation-delay: 0.3s; }
  .pulse span:nth-child(3) { animation-delay: 0.6s; }
  @keyframes pulse { 0%, 100% { opacity: 0.25; transform: scaleX(0.7); } 50% { opacity: 1; transform: scaleX(1); } }

  /* peek trigger — clean, centered, no arrow */
  .peek-trigger { margin-top: 6px; background: transparent; border: none; padding: 14px 2px 11px; font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.36em; text-indent: 0.36em; text-transform: uppercase; color: var(--ink); cursor: pointer; position: relative; text-align: center; transition: color 240ms ease; }
  .peek-trigger::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 26px; height: 1px; background: var(--gold); transform: translateX(-50%); opacity: 0.55; transition: width 320ms var(--ease), opacity 240ms ease; }
  .peek-trigger:hover { color: var(--gold); }
  .peek-trigger:hover::after { width: calc(100% - 4px); opacity: 0.9; }
  .peek-trigger[aria-expanded="true"]::after { width: calc(100% - 4px); opacity: 0.8; }
  .peek-trigger[aria-expanded="true"] .label-open { display: none; }
  .peek-trigger[aria-expanded="false"] .label-close { display: none; }

  /* peek panel (collapsible instrument case) */
  .peek-panel { width: 100%; max-width: 1100px; margin: 0 auto; overflow: hidden; max-height: 0; opacity: 0; transition: max-height 520ms var(--ease), opacity 380ms ease, margin-top 420ms ease; }
  .peek-panel.open { max-height: 2600px; opacity: 1; margin-top: 56px; }

  .peek-header { display: flex; align-items: center; gap: 18px; justify-content: center; padding: 0 24px 36px; }
  .peek-header .rule { flex: 1; max-width: 120px; height: 1px; background: var(--rule); }
  .peek-header .label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.36em; text-transform: uppercase; color: var(--ink-soft); }
  .peek-lede { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(18px, 2.2vw, 25px); line-height: 1.4; text-align: center; color: var(--ink); max-width: 30em; margin: 0 auto 48px; }
  .peek-lede .accent { color: var(--gold); font-style: normal; }

  .instruments { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; padding: 0 24px 24px; }
  .instrument { display: flex; flex-direction: column; gap: 14px; }
  .instrument .accent-rule { width: 38px; height: 2px; background: var(--accent); margin-bottom: 4px; }
  .instrument .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); }
  .instrument .eyebrow .roman { color: var(--accent); margin-right: 8px; }
  .instrument .hero { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); line-height: 1.4; margin: -4px 0 0; }
  .instrument .name { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4vw, 48px); line-height: 0.95; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
  .instrument .name a { transition: opacity 160ms ease; }
  .instrument .name a:hover { opacity: 0.7; }
  .instrument .name .stop { color: var(--accent); }
  .instrument .role { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 16px; color: var(--ink-soft); margin: 0; line-height: 1.3; }
  .instrument .body { font-size: 14px; line-height: 1.65; color: var(--ink); margin: 6px 0 0; max-width: 32ch; }
  .instrument .detail-link { align-self: flex-start; margin-top: 4px; padding: 8px 0 3px; border-bottom: 1px solid var(--accent); font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); transition: color 180ms ease; }
  .instrument .detail-link:hover { color: var(--accent); }

  @media (max-width: 1080px) { .instruments { grid-template-columns: repeat(2, 1fr); gap: 44px; max-width: 740px; margin: 0 auto; } .instrument .body { max-width: 100%; } }
  @media (max-width: 560px) {
    .home-stage { padding: 16px 22px; }
    .wordmark { letter-spacing: 0.36em; text-indent: 0.36em; }
    .instruments { grid-template-columns: 1fr; max-width: 420px; gap: 48px; }
    .peek-header { padding: 0 8px 28px; gap: 12px; }
    .peek-header .rule { max-width: 50px; }
    .peek-panel.open { margin-top: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse span { animation: none; opacity: 0.6; }
    .peek-panel { transition: none; }
    .peek-trigger::after { transition: none; }
  }
</style>
