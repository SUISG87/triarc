---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Triarc',
  url: 'https://triarc.ch/',
  email: 'manuel@triarc.ch',
  founder: { '@type': 'Person', name: 'Manuel Bänziger' },
  description: 'Three services for hospitality: operational consulting, recruiting and head-of cover, and software for the operation — from professionals who still work the floor.',
  address: { '@type': 'PostalAddress', addressLocality: 'St. Gallen', addressCountry: 'CH' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Hospitality software',
          url: 'https://triarc.ch/en/software',
          description: 'Four instruments for revenue, staffing, hygiene and kitchen planning — plus custom software built in the Atelier.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Hospitality consulting',
          url: 'https://triarc.ch/en/beratung',
          description: 'Front and back office, operations and costing, openings and concept, leadership and team.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Hospitality recruiting',
          url: 'https://triarc.ch/en/recruiting',
          description: 'Head-of roles and every position in the house — kitchen, service, front and back office, housekeeping, patisserie, maintenance — plus cover at short notice.',
        },
      },
    ],
  },
};
---
<Base
  title="Triarc — Consulting, people and software for hospitality & hotels"
  description="Three services for hospitality: operational consulting from professionals who still work the floor, recruiting including cover for head-of roles within 48 hours, and software for the operation. From practice, not from theory."
  lang="en"
  crumb="CH"
  altHref="/"
  hreflang={{ de: '/', en: '/en/' }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <Home lang="en" />
</Base>
