---
// Top meta register with language + theme toggles.
// Props: crumb (right-of-Triarc label), lang ('de'|'en'), altHref (other-language URL for this page or null)
const { crumb = 'CH', lang = 'de', altHref = null } = Astro.props;
const home = lang === 'en' ? '/en/' : '/';
---
<header class="meta">
  <div class="left">
    <span class="dot" aria-hidden="true"></span>
    <a href={home}>Triarc</a>
    <span class="sep" aria-hidden="true">·</span>
    <span class="crumb">{crumb}</span>
  </div>
  <div class="right">
    {altHref && (
      <!-- the current language is plain text, not a link to nowhere -->
      <span class="lang-toggle" aria-label="Sprache / Language">
        {lang === 'de'
          ? <span aria-current="true">DE</span>
          : <a href={altHref} data-lang="de">DE</a>}
        <span class="sep" aria-hidden="true">/</span>
        {lang === 'en'
          ? <span aria-current="true">EN</span>
          : <a href={altHref} data-lang="en">EN</a>}
      </span>
    )}
    <button class="toggle-btn theme-toggle" type="button" aria-label="Theme wechseln" data-theme-toggle>
      <span class="moon" aria-hidden="true">☾</span>
      <span class="sun" aria-hidden="true">☀</span>
    </button>
    <span class="year">2026</span>
  </div>
</header>
