---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import '../styles/detail.css';
const mailto = "mailto:manuel@triarc.ch?subject=Beratung%20%E2%80%93%20vertrauliche%20Anfrage&body=Betrieb%3A%0AWorum%20geht%20es%3A%0AZeitrahmen%3A%0A";
---
<Base
  title="Operative Beratung für Gastronomie & Hotellerie — von aktiven Profis | Triarc"
  description="Hands-on Beratung von einem weltweiten Netz aktiver Fachleute, die weiterhin täglich in Hotellerie und Gastronomie arbeiten: Front Office, Küche, F&B, Housekeeping, Patisserie. Auf Ihr Haus und Ihr Niveau abgestimmt, absolut diskret — und ohne sechsstelliges Mandat."
  lang="de"
  crumb="Beratung"
  altHref="/en/beratung"
  hreflang={{ de: '/beratung', en: '/en/beratung' }}
>
  <main id="main" class="detail" style="--accent: var(--gold); --accent-wash: color-mix(in srgb, var(--gold) 7%, transparent);">
    <section class="instrument-hero">
      <div>
        <Mark size={76} />
        <p class="d-eyebrow"><span class="roman">II</span>Operative Beratung · hands-on</p>
        <h1 class="d-h1">Beratung<span class="stop">.</span></h1>
      </div>
      <div>
        <p class="section-kicker">Leistung II von III</p>
        <p class="role">Kein Berater von der Stange.<br />Ein Profi aus Ihrem Fach.</p>
        <p class="hero-intro">Der erste Schritt ist einzusehen, dass man Hilfe braucht. Der zweite ist, die richtige zu holen: bei uns kommt jemand, der heute noch selbst im Betrieb steht — in einem Hotel, in einer Küche, an einer Reception, irgendwo auf der Welt. Abgestimmt auf Ihr Haus und auf das Niveau, das Sie fahren wollen — und selbstverständlich diskret.</p>
        <div class="btn-row">
          <a class="btn" href={mailto}>Vertraulich anfragen <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn-ghost" href="#profis">Wer zu Ihnen kommt</a>
        </div>
      </div>
    </section>

    <section class="trust-strip">
      <span class="who">Von den Gründern <strong>Manuel &amp; Lalaine Bänziger</strong></span>
      <span class="items"><span>Küche &amp; F&amp;B</span><span>Front Office &amp; Reception</span><span>je 20+ Jahre international</span><span>Weltweites Netz aktiver Profis</span><span>Diskret als Standard</span></span>
    </section>

    <section class="split reveal">
      <div>
        <p class="section-kicker">Der erste Schritt</p>
        <p class="pull">Einzusehen, dass man Hilfe braucht.</p>
      </div>
      <div>
        <p class="body">Das ist in dieser Branche das Schwerste. Wer ein Haus führt, hat gelernt, Probleme selbst zu lösen — und genau deshalb bleibt vieles zu lange liegen. Sich Hilfe zu holen fühlt sich an wie ein Eingeständnis.</p>
        <p class="body">Diskretion ist bei uns Standard, keine Zusatzleistung: Anfrage, Besuch und Befund bleiben im Haus, und wir nennen Sie in keiner Referenz. Auf Wunsch ist der Profi im Betrieb einfach jemand, der mitarbeitet.</p>
        <p class="body">Und es ist kein sechsstelliges Mandat. Keine Präsentation, die danach in einer Schublade liegt — sondern jemand, der ein paar Tage bei Ihnen und mit Ihnen in der Tagesoperation arbeitet und wieder geht, sobald es nach Ihren Wünschen läuft.</p>
      </div>
    </section>


    <section class="block reveal" id="check">
      <div class="block-head">
        <h2 class="section-kicker">Wo klemmt es?</h2>
        <p class="pull">Kreuzen Sie an, was Ihnen bekannt vorkommt.</p>
      </div>
      <p class="body" style="max-width:44rem; margin:-20px 0 30px;">Kein Formular, keine Adresse, kein Newsletter. Die Punkte, die Sie ankreuzen, landen in einer vorbereiteten E-Mail — abschicken oder nicht, entscheiden Sie.</p>
      <form class="check" id="check-form">
        <ul class="check-list">
          <li><label><input type="checkbox" value="Der Foodcost stimmt auf dem Papier, aber nicht auf dem Konto." /><span class="box" aria-hidden="true"></span><span class="txt">Der Foodcost stimmt auf dem Papier, aber nicht auf dem Konto.</span></label></li>
          <li><label><input type="checkbox" value="Die Karte ist gewachsen, die Marge nicht." /><span class="box" aria-hidden="true"></span><span class="txt">Die Karte ist gewachsen, die Marge nicht.</span></label></li>
          <li><label><input type="checkbox" value="Jede Woche dieselben Diskussionen um den Dienstplan." /><span class="box" aria-hidden="true"></span><span class="txt">Jede Woche dieselben Diskussionen um den Dienstplan.</span></label></li>
          <li><label><input type="checkbox" value="Übergaben zwischen Reception, Küche und Service gehen unter." /><span class="box" aria-hidden="true"></span><span class="txt">Übergaben zwischen Reception, Küche und Service gehen unter.</span></label></li>
          <li><label><input type="checkbox" value="Das Team wechselt schneller, als wir einarbeiten können." /><span class="box" aria-hidden="true"></span><span class="txt">Das Team wechselt schneller, als wir einarbeiten können.</span></label></li>
          <li><label><input type="checkbox" value="Eine Kaderstelle ist offen — oder wird es bald." /><span class="box" aria-hidden="true"></span><span class="txt">Eine Kaderstelle ist offen — oder wird es bald.</span></label></li>
          <li><label><input type="checkbox" value="Wir wissen erst am Monatsende, wie der Monat gelaufen ist." /><span class="box" aria-hidden="true"></span><span class="txt">Wir wissen erst am Monatsende, wie der Monat gelaufen ist.</span></label></li>
          <li><label><input type="checkbox" value="Die Systeme kosten, aber niemand nutzt sie ganz." /><span class="box" aria-hidden="true"></span><span class="txt">Die Systeme kosten, aber niemand nutzt sie ganz.</span></label></li>
          <li><label><input type="checkbox" value="Die Hygiene-Doku entsteht am Abend vor der Kontrolle." /><span class="box" aria-hidden="true"></span><span class="txt">Die Hygiene-Doku entsteht am Abend vor der Kontrolle.</span></label></li>
          <li><label><input type="checkbox" value="Das Konzept passt nicht mehr zum Gast, der tatsächlich kommt." /><span class="box" aria-hidden="true"></span><span class="txt">Das Konzept passt nicht mehr zum Gast, der tatsächlich kommt.</span></label></li>
        </ul>
        <div class="check-foot">
          <a class="btn" id="check-send" href={mailto} data-subject="Beratung – vertrauliche Anfrage" data-intro="Bei uns klemmt es hier:" data-none="Nichts angekreuzt? Schreiben Sie einfach, was Sie beschäftigt.">Anfrage vorbereiten <span class="arr" aria-hidden="true">→</span></a>
          <p class="check-note" id="check-count" aria-live="polite">Nichts ausgewählt — Sie können auch einfach schreiben.</p>
        </div>
      </form>
    </section>

    <section class="block reveal" id="profis">
      <div class="block-head">
        <h2 class="section-kicker">Wer zu Ihnen kommt</h2>
        <p class="pull">Ihr Problem. Genau der Profi dazu.</p>
      </div>
      <p class="body" style="max-width:44rem; margin:-20px 0 34px;">Kein Berater, der von aussen draufschaut — jemand, der die Schicht kennt, weil er sie noch arbeitet. Sie bekommen bei uns nie einen Berater, der nicht weiterhin selbst in Hotellerie oder Gastronomie arbeitet. Wer zu Ihnen kommt, hatte dasselbe Problem letzte Woche im eigenen Haus — wir suchen ihn in einem weltweiten Netz von Fachleuten, nicht in einer Beraterliste.</p>
      <div class="cap-grid">
        <div class="cap"><span class="num">01</span><h3>Front Office &amp; Reception</h3><p>Ein aktiver Front Office Manager nimmt sich Ihrer Reception an — Ankunft, Reservation, Übergaben und die Systemarbeit von Opera bis zur täglichen Schichtübergabe.</p></div>
        <div class="cap"><span class="num">02</span><h3>Küche &amp; Produktion</h3><p>Ein Executive Chef, der selbst täglich im Geschäft steht, geht mit Ihnen durch Posten, Mise en place, Karte und Kalkulation.</p></div>
        <div class="cap"><span class="num">03</span><h3>F&amp;B &amp; Service</h3><p>Ein aktiver F&amp;B-Manager sieht sich Service, Abläufe, Karte und die Zahlen dahinter an — im laufenden Betrieb, nicht auf Papier.</p></div>
        <div class="cap"><span class="num">04</span><h3>Housekeeping</h3><p>Eine Housekeeping-Leitung aus der Praxis prüft Standards, Zeitwerte und Personaleinsatz — dort, wo sich die Bewertung eines Hauses entscheidet.</p></div>
        <div class="cap"><span class="num">05</span><h3>Patisserie &amp; Bäckerei</h3><p>Ein Patissier oder Bäcker, der weiterhin selbst produziert, nimmt sich Ihrer Produktion an: Rezepturen, Abläufe, Haltbarkeit, Ausbeute.</p></div>
        <div class="cap"><span class="num">06</span><h3>Betrieb, Zahlen &amp; Systeme</h3><p>Kalkulation, Foodcost, Personalquote — und die Frage, welche Systeme ein Haus wirklich braucht und welche es nur bezahlt. Herstellerneutral.</p></div>
        <div class="cap"><span class="num">07</span><h3>Neueröffnung &amp; Konzept</h3><p>Von der Idee zum funktionierenden Betrieb: Konzept, Kalkulationsgrundlagen, Abläufe, Aufbau des Teams — begleitet bis zum ersten Service.</p></div>
        <div class="cap"><span class="num">08</span><h3>Führung &amp; Team</h3><p>Teamaufbau, Führungscoaching und Schulung von Betriebsleitung und Team. Damit das, was eingeführt wurde, auch danach gelebt wird.</p></div>
      </div>
    </section>

    <section class="nachweis reveal" id="niveau">
      <div>
        <p class="section-kicker">Auf Ihr Niveau</p>
        <h2>Es muss zu Ihrem Haus passen.</h2>
        <p>Es bringt nichts, einen Fünf-Sterne-F&amp;B-Manager in ein Haus zu schicken, das Berggastronomie mit gut bürgerlichem Einschlag fahren will. Ein gutes Konzept ist eines, das zum Haus, zum Gast und zum Team passt — nicht eines, das eine Stufe imitiert, die niemand bestellt hat. Wir wählen den Profi nach Ihrem Betrieb aus, nicht nach unserem Prospekt.</p>
      </div>
      <div>
        <ul class="doc-list">
          <p class="lbl">Wir fragen zuerst</p>
          <li>Welches Haus führen Sie — und welches wollen Sie führen?</li>
          <li>Welchen Gast bedienen Sie heute wirklich?</li>
          <li>Welches Niveau will und kann das Team tragen?</li>
          <li>Was ist im Budget realistisch?</li>
        </ul>
      </div>
    </section>

    <section class="block reveal">
      <h2 class="section-kicker">Ablauf</h2>
      <p class="pull">Wie eine Zusammenarbeit läuft.</p>
      <div class="steps">
        <div class="step"><span class="n">1</span><h3>Vertrauliches Gespräch</h3><p>Sie sagen, wo es klemmt. Wir sagen, wer aus unserem Kreis dazu passt — und ob wir überhaupt die Richtigen sind.</p></div>
        <div class="step"><span class="n">2</span><h3>Mitarbeiten</h3><p>Der Profi steht mit in der Schicht — Küche, Service, Reception, Housekeeping, Büro — und rechnet parallel nach.</p></div>
        <div class="step"><span class="n">3</span><h3>Umsetzen im Betrieb</h3><p>Befund, Massnahmen und die Umsetzung auf jeder Stufe mit — bis das Team es ohne uns kann.</p></div>
      </div>
      <div class="assurance">
        <span>Diskretion als Standard — Anfrage, Besuch und Befund bleiben im Haus</span>
        <span>Nur aktive Praktiker, keine Berufsberater — weltweit</span>
        <span>Kein sechsstelliges Mandat, klarer Rahmen statt offener Tagessätze</span>
        <span>Auch dann ehrlich, wenn die Antwort keine Software ist</span>
      </div>
    </section>



    <section class="cta-band reveal">
      <h2>Sagen Sie es einmal laut.</h2>
      <p>Ein vertrauliches Gespräch kostet nichts und klärt meistens schon, wer zu Ihnen passt — und wenn wir es nicht sind, sagen wir Ihnen das.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn" href={mailto}>Vertraulich anfragen <span class="arr" aria-hidden="true">→</span></a></div>
      <p class="contact-line">Direkt: <a href="mailto:manuel@triarc.ch">manuel@triarc.ch</a></p>
    </section>

    <nav class="instrument-nav" aria-label="Triarc Leistungen">
      <a href="/">← Übersicht</a>
      <div class="links"><a href="/software">Software</a><a href="/beratung" aria-current="page">Beratung</a><a href="/recruiting">Recruiting</a></div>
    </nav>
  </main>
</Base>

<script>
  // The checklist writes the enquiry for you: whatever is ticked becomes the
  // body of a normal mailto. No form post, no storage, nothing leaves the
  // page until the visitor sends the mail themselves.
  const form = document.getElementById('check-form');
  const send = document.getElementById('check-send');
  const note = document.getElementById('check-count');
  if (form && send && note) {
    const base = send.getAttribute('href');
    const subject = send.dataset.subject;
    const intro = send.dataset.intro;
    const none = send.dataset.none;
    const emptyNote = note.textContent;
    const sync = () => {
      const picked = Array.from(form.querySelectorAll('input:checked')).map((i) => '- ' + i.value);
      if (!picked.length) {
        send.setAttribute('href', base);
        note.textContent = emptyNote;
        return;
      }
      const body = intro + '\n\n' + picked.join('\n') + '\n\nBetrieb:\n';
      send.setAttribute('href', 'mailto:manuel@triarc.ch?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body));
      note.textContent = picked.length === 1 ? '1 Punkt ausgewählt' : picked.length + ' Punkte ausgewählt';
    };
    form.addEventListener('change', sync);
    form.addEventListener('submit', (e) => e.preventDefault());
    sync();
  }
</script>


<style>
  /* the service names are longer words than Aurora/Nova/Zenith/Ceres,
     so the display size steps down to keep them inside the column */
  .d-h1 { font-size: clamp(40px, 5.8vw, 74px); }

  /* the self-check: ticking is the whole interaction, so the boxes are the
     only new atom — a hairline square that takes the house diamond */
  .check-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .check-list li { background: var(--paper); }
  .check-list label { display: flex; align-items: flex-start; gap: 14px; padding: 18px 22px; cursor: pointer; transition: background 200ms ease; }
  .check-list label:hover { background: var(--accent-wash); }
  .check-list input { position: absolute; opacity: 0; width: 0; height: 0; }
  .check-list .box { flex: none; width: 13px; height: 13px; margin-top: 3px; border: 1px solid var(--rule); position: relative; transition: border-color 200ms ease; }
  .check-list label:hover .box { border-color: var(--gold); }
  .check-list .box::after { content: ""; position: absolute; inset: 2px; background: var(--gold); transform: rotate(45deg) scale(0); transition: transform 200ms var(--ease); }
  .check-list input:checked + .box::after { transform: rotate(45deg) scale(1); }
  .check-list input:focus-visible + .box { outline: 2px solid var(--gold); outline-offset: 3px; }
  .check-list .txt { font-size: 14.5px; line-height: 1.6; color: var(--ink); }
  .check-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 24px; margin-top: 28px; }
  .check-note { font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-soft); margin: 0; }
  @media (max-width: 820px) { .check-list { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .check-list .box::after, .check-list label { transition: none; } }

</style>
