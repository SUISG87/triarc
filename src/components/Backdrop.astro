---
/*
  Backdrop — the Alpstein at alpenglow behind the home hero.

  The photograph is a 2400×500 panorama: almost all massif, with only a thin
  band of sky above the ridge. So the sky is continued upward in its own
  colour (sampled from the top of the frame, rgb(58,57,52) — it varies by less
  than two values over the whole band), which lets the lockup stand *in* the
  sky instead of on the page above it. The extension carries the same opacity
  and filter as the photograph, so the two stay matched in both themes, and it
  dissolves at the very top rather than ending on an edge.

  Ridge.astro keeps the engraved line-art alternative.
*/
import { Image } from 'astro:assets';
import alpstein from '../assets/alpstein-saentis.jpg';

const { alt } = Astro.props;
---
<div class="backdrop" role="img" aria-label={alt}>
  <div class="frame">
  <div class="sky" aria-hidden="true"></div>
  <Image
    src={alpstein}
    alt=""
    widths={[900, 1400, 2000, 2400]}
    sizes="100vw"
    format="webp"
    quality={72}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  </div>
</div>

<script>
  // A slow drift as the hero scrolls away — the horizon lingers. Only the
  // massif moves; the sky it sits in is flat, so the seam stays invisible.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const backdrop = document.querySelector('.backdrop img');
  if (backdrop && !reduce.matches) {
    let queued = false;
    const paint = () => {
      queued = false;
      backdrop.style.transform = `translate3d(0, ${window.scrollY * 0.07}px, 0)`;
    };
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; window.requestAnimationFrame(paint); }
    }, { passive: true });
    paint();
  }
</script>

<style>
  .backdrop {
    /* the sky reaches up past the meta register, so the page opens in it */
    --bleed: 104px;
    /* room below the hero for the frame's fade to finish INSIDE the box: a
       mask that is still painting when the box clips it ends on a cut */
    --tail: 150px;
    --band: clamp(210px, 30vh, 320px);
    --sky: rgb(58, 57, 52);

    position: absolute;
    left: 50%;
    top: calc(-1 * var(--bleed));
    height: calc(100% + var(--bleed) + var(--tail));
    width: 100vw;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    /* kept short: the backdrop is the largest element above the fold, so a
       long fade would land straight in the reported LCP */
    animation: backdrop-in 900ms var(--ease) 80ms forwards;
  }

  /* the continued sky — flat, because the photograph's own sky is */
  /* one layer carries the whole treatment, so the sky and the photograph
     never stack their alpha against each other and no seam appears */
  .frame { position: absolute; inset: 0; }

  .sky {
    position: absolute;
    inset: 0;
    /* it dissolves at both ends — into the page above the register, and below
       the ridge, so the hero never closes on an edge */
    background: linear-gradient(to bottom, transparent 0%, var(--sky) 20%, var(--sky) 50%, color-mix(in srgb, var(--sky) 40%, transparent) 66%, transparent 82%);
  }

  .backdrop :global(img) {
    position: absolute;
    /* the ridge sits low enough that the scroll cue keeps clear of lit snow */
    left: 0; bottom: calc(var(--tail) - 38px);
    width: 100%;
    height: var(--band);
    object-fit: cover;
    object-position: 50% 30%;
    display: block;
    will-change: transform;
    /* the top dissolves into the continued sky it matches; the bottom runs
       all the way to nothing inside the tail, so no edge is ever clipped */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 12%, #000 52%, rgba(0,0,0,0.45) 70%, rgba(0,0,0,0.12) 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 12%, #000 52%, rgba(0,0,0,0.45) 70%, rgba(0,0,0,0.12) 84%, transparent 100%);
  }

  /* on paper the frame was held so far back that the massif nearly vanished;
     it now carries real weight, with the alpenglow left warm rather than
     desaturated into grey */
  .frame {
    opacity: 0.62;
    filter: saturate(0.88) contrast(1.04);
  }

  /* on paper the massif carries the weight, but the sky above it stays pale —
     the lockup and the gold register have to stay readable on it. The frame's
     top fade is stretched to match, so the photograph's own darker sky washes
     into the pale extension instead of meeting it on a line. */
  :global(:root[data-theme="light"]) .sky { opacity: 0.34; }
  :global(:root[data-theme="light"]) .backdrop :global(img) {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 40%, #000 56%, rgba(0,0,0,0.42) 70%, rgba(0,0,0,0.1) 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 40%, #000 56%, rgba(0,0,0,0.42) 70%, rgba(0,0,0,0.1) 84%, transparent 100%);
  }

  @keyframes backdrop-in { to { opacity: 1; } }

  /* on dark the alpenglow is already the brand gold — let it run */
  :global(:root[data-theme="dark"]) .frame {
    opacity: 0.78;
    filter: saturate(0.92) contrast(1.02);
  }

  @media (max-width: 640px) {
    /* a narrow viewport crops the panorama hard, so the band is kept shorter
       (less zoom on the peak) and sits lower, clear of the status line */
    .backdrop { --bleed: 88px; --band: clamp(160px, 22vh, 200px); }
    .backdrop :global(img) { bottom: calc(var(--tail) - 52px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .backdrop { opacity: 1; animation: none; }
    .backdrop :global(img) { will-change: auto; }
  }
</style>
