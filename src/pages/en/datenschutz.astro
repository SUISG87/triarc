---
import Base from '../../layouts/Base.astro';

const sections = [
  { n: '01', h: 'Controller', body: ['Manuel Bänziger, Triarc, St. Gallen, Switzerland.<br>Contact: <a class="link" href="mailto:manuel@triarc.ch">manuel@triarc.ch</a>'] },
  { n: '02', h: 'What data we process', body: [
    'When you visit this website, technically necessary data is generated, and you may send us data yourself:',
    '<ul><li><strong>Server log data</strong> — when the site is accessed, our hosting provider (see section 4) automatically processes information such as IP address, date/time, the page requested and browser details. This is used solely for the secure, stable operation of the website.</li><li><strong>Getting in touch</strong> — if you email us or request a quote, we process the data you provide (name, email address, details about your business, the content of your message) in order to answer your enquiry.</li></ul>',
    'This website uses <strong>no cookies of its own</strong> and no web tracking. No profiling takes place.',
  ] },
  { n: '03', h: 'Purpose & legal basis', body: ['We process personal data to provide and secure the website and to answer enquiries and initiate business relationships. Where the GDPR applies, processing is based on our legitimate interest in secure operation (Art. 6(1)(f) GDPR) or on the initiation or performance of a contract (Art. 6(1)(b) GDPR).'] },
  { n: '04', h: 'Hosting', body: ['This website is hosted by <strong>Vercel Inc.</strong> Vercel processes the server log data referred to in section 2 as our processor. Delivery is via a global content delivery network; processing may therefore take place on servers outside Switzerland and the EU (including in the USA). Appropriate contractual data-protection safeguards are in place.'] },
  { n: '05', h: 'Fonts (Google Fonts)', body: ['For consistent presentation, this website loads fonts from <strong>Google Fonts</strong> (Google Ireland Ltd.). Your IP address is transmitted to Google in the process. No cookies are set for this.'] },
  { n: '06', h: 'Disclosure to third parties', body: ['We do not sell personal data. Disclosure occurs only to the service providers used to operate the website (sections 4 and 5), to parties legally entitled, or with your consent.'] },
  { n: '07', h: 'Retention', body: ['We retain personal data only for as long as necessary for the stated purposes or as required by law. Email enquiries are deleted once they are no longer needed and no retention obligation applies.'] },
  { n: '08', h: 'Your rights', body: [
    'Within the scope of applicable law, you have in particular the right to:',
    '<ul><li>information about the data we process about you</li><li>correction of inaccurate data</li><li>deletion or restriction of processing</li><li>release or portability of your data</li><li>object to certain processing</li></ul>',
    'A message to <a class="link" href="mailto:manuel@triarc.ch">manuel@triarc.ch</a> is enough to exercise these rights. You may also lodge a complaint with the competent supervisory authority — in Switzerland, the Federal Data Protection and Information Commissioner (FDPIC).',
  ] },
  { n: '09', h: 'Changes', body: ['We update this privacy policy when our website or the legal situation changes. The version published here applies in each case.', '<span class="updated">Last updated: June 2026</span>'] },
];
---
<Base
  title="Privacy Policy | Triarc"
  description="Triarc privacy policy — how we handle personal data. revDSG- and GDPR-compliant, without tracking."
  lang="en"
  crumb="Privacy"
  altHref="/datenschutz"
>
  <main class="legal">
    <p class="eyebrow">Legal</p>
    <h1>Privacy Policy<span class="stop">.</span></h1>
    <p class="lede">We process personal data sparingly and transparently — in line with the revised Swiss Data Protection Act (revDSG) and, where applicable, the EU General Data Protection Regulation (GDPR). This website uses <strong>no tracking or analytics tools and no advertising cookies</strong>.</p>

    {sections.map((s) => (
      <section class="lblock">
        <h2><span class="num">{s.n}</span>{s.h}</h2>
        {s.body.map((p) => <p set:html={p}></p>)}
      </section>
    ))}
  </main>
</Base>

<style>
  .legal { width: min(760px, calc(100% - 56px)); margin: 0 auto; padding: 24px 0; }
  .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold); margin: 0 0 16px; }
  h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(38px, 5.6vw, 64px); line-height: 0.96; letter-spacing: -0.01em; margin: 0 0 8px; }
  h1 .stop { color: var(--gold); }
  .lede { font-size: 16.5px; line-height: 1.7; color: var(--ink-soft); max-width: 44rem; margin: 0 0 48px; padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .lede strong { color: var(--ink); font-weight: 500; }
  .lblock { padding: 0 0 38px; }
  .lblock h2 { font-family: var(--serif); font-weight: 400; font-size: 22px; line-height: 1.2; margin: 0 0 14px; }
  .lblock :global(.num) { font-family: var(--mono); font-size: 11px; color: var(--gold); margin-right: 10px; }
  .lblock p { margin: 0 0 12px; font-size: 15.5px; line-height: 1.75; color: var(--ink); }
  .lblock :global(ul) { margin: 0 0 12px; padding: 0; list-style: none; display: grid; gap: 9px; }
  .lblock :global(li) { position: relative; padding-left: 20px; font-size: 15px; line-height: 1.6; color: var(--ink); }
  .lblock :global(li)::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }
  .lblock :global(strong) { font-weight: 500; }
  .lblock :global(.link) { border-bottom: 1px solid var(--gold); padding-bottom: 1px; transition: color 180ms ease; }
  .lblock :global(.link):hover { color: var(--gold); }
  .lblock :global(.updated) { font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-soft); }
</style>
