---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Holding from '../components/Holding.astro';

const {
  title,
  description,
  lang = 'de',
  crumb = 'CH',
  ogType = 'website',
  altHref = null,
  hreflang = null, // { de: '/', en: '/en/' }
  showFooter = true,
} = Astro.props;

// --- Maintenance mode (holding page) ------------------------------------
// Every route serves the bilingual holding page except the two legal pages,
// which stay live for the Swiss disclosure obligation.
// To bring the site back: revert this PR (or flip MAINTENANCE to false and
// restore the sitemap integration + robots.txt).
const MAINTENANCE = true;
const LEGAL = ['/impressum', '/datenschutz', '/en/impressum', '/en/datenschutz'];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const holding = MAINTENANCE && !LEGAL.includes(path);

const site = Astro.site ?? new URL('https://triarc.ch');
const canonical = new URL(Astro.url.pathname, site).href;
// gold arcs on the dark paper, matching the house theme
const favicon = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2314120d'/><g fill='none' stroke='%23c8a84b' stroke-width='6' stroke-linecap='round'><path d='M 90 50 A 40 40 0 0 1 36.32 87.59'/><path d='M 30 84.64 A 40 40 0 0 1 24.29 19.36'/><path d='M 30 15.36 A 40 40 0 0 1 89.39 43.05'/></g><polygon points='50,44 56,50 50,56 44,50' fill='%23c8a84b'/></svg>";
---
<!doctype html>
<!-- dark is the house theme: stamped server-side so it also holds without JS -->
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{holding ? 'Triarc — Die Seite wird überarbeitet' : title}</title>
  <meta name="description" content={holding ? 'Die Website von Triarc wird überarbeitet. Triarc arbeitet weiter — Software, Beratung, Recruiting. Kontakt: manuel@triarc.ch' : description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={favicon} />
  <meta name="theme-color" content="#14120d" />

  {!holding && hreflang && (
    <>
      <link rel="alternate" hreflang="de" href={new URL(hreflang.de, site).href} />
      <link rel="alternate" hreflang="en" href={new URL(hreflang.en, site).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(hreflang.de, site).href} />
    </>
  )}

  <meta property="og:title" content={holding ? 'Triarc — Die Seite wird überarbeitet' : title} />
  <meta property="og:description" content={holding ? 'Die Website von Triarc wird überarbeitet. Triarc arbeitet weiter — Software, Beratung, Recruiting.' : description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Triarc" />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:ital,wght@0,300;0,400;1,300;1,400&family=Geist+Mono:wght@300;400&display=swap" rel="stylesheet" />

  <!-- page-level head content (JSON-LD, OG images) stays off the holding page -->
  {!holding && <slot name="head" />}

  <script is:inline define:vars={{ pageLang: lang, altHref: holding ? null : altHref }}>
    // Carry-over: if the visitor has a stored language preference and a
    // counterpart page exists, send them to their language before paint.
    (function () {
      try {
        var pref = localStorage.getItem('triarc-lang');
        if (pref && altHref && pref !== pageLang) { location.replace(altHref); }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    (function () {
      document.documentElement.classList.add('js');
      try {
        // Dark unless the visitor has chosen light — the system preference no
        // longer decides, because dark is the brand's front door.
        var t = localStorage.getItem('triarc-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
        if (t === 'light') {
          var m = document.createElement('meta');
          m.setAttribute('name', 'theme-color');
          m.setAttribute('data-manual', '');
          m.setAttribute('content', '#f7f4ed');
          document.head.appendChild(m);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen'}</a>
  {holding ? (
    <Holding />
  ) : (
    <>
      <SiteHeader crumb={crumb} lang={lang} altHref={altHref} />
      <slot />
      {showFooter && <SiteFooter lang={lang} />}
    </>
  )}

  <script>
    // Persist language choice when the visitor uses the DE/EN toggle
    document.querySelectorAll('.lang-toggle a[data-lang]').forEach((a) => {
      a.addEventListener('click', () => {
        try { localStorage.setItem('triarc-lang', a.dataset.lang); } catch (e) {}
      });
    });
    // Theme toggle. The two media-scoped theme-color metas cover first paint;
    // once the visitor overrides the theme, an unscoped one has to win.
    const paintThemeColor = (theme) => {
      let m = document.querySelector('meta[name="theme-color"][data-manual]');
      if (!m) {
        m = document.createElement('meta');
        m.setAttribute('name', 'theme-color');
        m.setAttribute('data-manual', '');
        document.head.appendChild(m);
      }
      m.setAttribute('content', theme === 'dark' ? '#14120d' : '#f7f4ed');
    };
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        paintThemeColor(next);
        try { localStorage.setItem('triarc-theme', next); } catch (e) {}
      });
    });
    // Scroll reveal
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && els.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -10% 0px' });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('in'));
    }
  </script>
</body>
</html>
